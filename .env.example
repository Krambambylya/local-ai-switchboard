# Copy to .env and adjust. Variables use the LAS_ prefix.
# The gateway does not use a password or API token.

# Windows PowerShell paths:
# LAS_INSTALL_ROOT=C:\Users\you\AI\local-ai-switchboard
# LAS_STORAGE_DIR=D:\AI\local-ai-switchboard\data
# LAS_LOG_DIR=D:\AI\local-ai-switchboard\logs

# macOS Terminal paths:
# LAS_INSTALL_ROOT=/Users/you/.local/share/local-ai-switchboard
# LAS_STORAGE_DIR=/Users/you/.local/share/local-ai-switchboard/data

LAS_OLLAMA_URL=http://127.0.0.1:11434
LAS_COMFYUI_URL=http://127.0.0.1:8188
# Portable ComfyUI root. Leave unset to use a ComfyUI that is already running.
# The launcher looks for python_embeded\python.exe and ComfyUI\main.py inside it.
# LAS_COMFYUI_PORTABLE_DIR=D:\AI\ComfyUI_windows_portable
# LAS_COMFYUI_RESERVE_VRAM_MB=1024
# LAS_WORKFLOWS_DIR=D:\AI\local-ai-switchboard\workflows
LAS_GPU_MEMORY_THRESHOLD_MB=1024
LAS_MAX_QUEUE_DEPTH=8
LAS_JOB_TIMEOUT_SECONDS=300
LAS_RELEASE_TIMEOUT_SECONDS=120
LAS_MEMORY_POLL_INTERVAL_SECONDS=0.5
# Delete finished image jobs older than this many days. 0 keeps them.
# LAS_OUTPUT_RETENTION_DAYS=14
LAS_API_HOST=0.0.0.0
LAS_API_PORT=8787
LAS_LOG_LEVEL=INFO
